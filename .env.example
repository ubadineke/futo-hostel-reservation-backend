# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roost?schema=public"

# HTTP port
PORT=3000

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Paystack — TEST MODE ONLY, get this from Paystack Dashboard > Settings >
# API Keys & Webhooks. Must start with sk_test_ — this project never charges
# real money, do not put a live (sk_live_) key here.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Only needed once, when running `npm run prisma:seed:prod` against a fresh
# production database (see backend/README.md). Not read by the app itself.
ADMIN_EMAIL="admin@example.edu.ng"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Hostel Officer"
