# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roost?schema=public"

# HTTP port
PORT=3000

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Remita webhook — server-to-server callback is verified with this shared secret
# via an HMAC-SHA256 signature sent in the `x-remita-signature` header.
REMITA_WEBHOOK_SECRET="change-me-remita-webhook-secret"

# Only needed once, when running `npm run prisma:seed:prod` against a fresh
# production database (see backend/README.md). Not read by the app itself.
ADMIN_EMAIL="admin@example.edu.ng"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Hostel Officer"
